{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the UI in the main window may call: the cos commands, and dragging the window by its header (double-click zooms).",
  "windows": ["main"],
  "permissions": [
    "allow-daemon-info",
    "allow-daemon-request",
    "allow-follow-events",
    "allow-attach-terminal",
    "allow-close-stream",
    "allow-hosts-list",
    "allow-host-add",
    "allow-host-remove",
    "allow-host-select",
    "allow-set-waiting-count",
    "allow-notify",
    "allow-reveal-path",
    "allow-open-in-terminal",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
